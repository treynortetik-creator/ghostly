# Authentication (Legacy username/password)
AUTH_USERNAME=your_username_here
AUTH_PASSWORD=your_secure_password_here
JWT_SECRET=your_jwt_secret_here_use_a_long_random_string

# Cron / Internal Worker Auth
CRON_SECRET=your_cron_secret_here

# Supabase Configuration (server-side — service role key)
# Get these from your Supabase project dashboard: https://app.supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Configuration (client-side — anon key for OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App URL (used for OAuth redirects, webhook callbacks)
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# OpenRouter API (for AI-powered features)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key

# Document Storage
DOCUMENT_UPLOAD_DIR=uploads           # Relative to app root (or absolute path)
DOCUMENT_MAX_SIZE_MB=10               # Max file size in MB

# Slack Integration (OAuth App)
# Create at https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
